<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yash Tea Adda | Har sip mein apna pan</title>
  <style>
    body {
      font-family: 'Poppins', sans-serif;
      margin: 0;
      background-color: #fff8f0;
      color: #3e2f1c;
    }
    header {
      background-color: #a0522d;
      color: #fff;
      text-align: center;
      padding: 2rem 1rem;
    }
    header h1 {
      margin: 0;
      font-size: 2.5rem;
    }
    header p {
      font-style: italic;
      margin-top: 0.5rem;
    }
    nav {
      background-color: #6b4226;
      text-align: center;
      padding: 0.5rem;
    }
    nav a {
      color: #fff;
      text-decoration: none;
      margin: 0 1rem;
      font-weight: bold;
    }
    nav a:hover {
      text-decoration: underline;
    }
    section {
      padding: 2rem;
      text-align: center;
    }
    .menu {
      display: flex;
      justify-content: center;
      gap: 2rem;
      flex-wrap: wrap;
    }
    .item {
      background: #fff;
      padding: 1rem;
      border-radius: 10px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      width: 200px;
    }
    .item img {
      width: 100%;
      border-radius: 10px;
    }
    form {
      background-color: #fff;
      max-width: 400px;
      margin: 0 auto;
      padding: 1.5rem;
      border-radius: 10px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    input, select, button {
      width: 100%;
      padding: 0.75rem;
      margin: 0.5rem 0;
      border: 1px solid #ccc;
      border-radius: 5px;
    }
    button {
      background-color: #a0522d;
      color: #fff;
      border: none;
      cursor: pointer;
      font-weight: bold;
    }
    button:hover {
      background-color: #6b4226;
    }
    footer {
      background-color: #6b4226;
      color: #fff;
      text-align: center;
      padding: 1rem;
    }
  </style>
</head>
<body>
  <header>
    <h1>Yash Tea Adda</h1>
    <p>“Har sip mein apna pan”</p>
  </header>

  <nav>
    <a href="#menu">Menu</a>
    <a href="#order">Order Online</a>
    <a href="#contact">Contact</a>
  </nav>

  <section id="menu">
    <h2>Our Menu</h2>
    <div class="menu">
      <div class="item">
        <img src="https://cdn.pixabay.com/photo/2017/01/06/19/15/tea-1951380_960_720.jpg" alt="Tea">
        <h3>Special Chai</h3>
        <p>₹15 / cup</p>
      </div>
      <div class="item">
        <img src="https://cdn.pixabay.com/photo/2017/08/10/08/33/coffee-2619013_960_720.jpg" alt="Coffee">
        <h3>Hot Coffee</h3>
        <p>₹25 / cup</p>
      </div>
    </div>
  </section>

  <section id="order">
    <h2>Order Online</h2>
    <form action="#" method="post">
      <label for="name">Your Name</label>
      <input type="text" id="name" name="name" placeholder="Enter your name" required>

      <label for="drink">Choose Your Drink</label>
      <select id="drink" name="drink">
        <option value="chai">Special Chai - ₹15</option>
        <option value="coffee">Hot Coffee - ₹25</option>
      </select>

      <label for="quantity">Quantity</label>
      <input type="number" id="quantity" name="quantity" min="1" value="1" required>

      <label for="address">Delivery Address</label>
      <input type="text" id="address" name="address" placeholder="Enter address" required>

      <button type="submit">Place Order</button>
    </form>
  </section>

  <section id="contact">
    <h2>Visit Us</h2>
    <p><strong>Location:</strong> Near Mathura Junction Railway Station</p>
    <p><strong>Open Hours:</strong> 6:00 AM – 10:00 PM</p>
  </section>

  <footer>
    <p>© 2025 Yash Tea Adda | Designed with ❤️ for chai lovers</p>
  </footer>
</body>
</html>
